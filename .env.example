# ==========================================
# HYDRA TORRENTS - ENVIRONMENT CONFIGURATION
# ==========================================

# Connection string for Layerbase PostgreSQL database
# Format: postgres://username:password@layerbase-host:5432/dbname?sslmode=require
LAYERBASE_DATABASE_URL=postgres://user:password@db.layerbase.com:5432/hydra_db?sslmode=require

# Secret Token for Admin Panel access and protected API operations
ADMIN_SECRET=hydra_super_secret_token_change_me_123

# Server Port (used in standalone Express mode, default: 7000)
PORT=7000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Solo para pruebas: inserta datos demo (magnets de ejemplo) si la tabla está vacía. Déjalo en false en producción.
SEED_DEMO_DATA=false

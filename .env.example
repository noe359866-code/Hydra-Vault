# ==========================================
# HYDRA TORRENTS - ENVIRONMENT CONFIGURATION
# ==========================================

# Connection string for Layerbase PostgreSQL database
# Format: postgres://username:password@layerbase-host:5432/dbname?sslmode=require
LAYERBASE_DATABASE_URL=postgres://user:password@db.layerbase.com:5432/hydra_db?sslmode=require

# Secret Token for Admin Panel access and protected API operations
ADMIN_SECRET=hydra_super_secret_token_change_me_123

# Server Port (used in standalone Express mode, default: 7000)
PORT=7000

# Node Environment ('production' or 'development')
NODE_ENV=production

# ==========================================
# PROWLARR (auto-llenado de torrents bajo demanda)
# ==========================================
# API Key of Prowlarr (Settings > General > API Key)
PROWLARR_API_KEY=

# Prowlarr base URL (no trailing slash). OPTIONAL:
# if empty but PROWLARR_API_KEY is set, it defaults to http://localhost:9696
# Docker Compose: http://prowlarr:9696
PROWLARR_URL=

# Max ms that /stream waits for a Prowlarr search before answering
# (the search continues in background and is cached for the retry)
PROWLARR_TIMEOUT_MS=8000

# Extra network margin (ms) for the background search after the response timeout
PROWLARR_GRACE_MS=8000

# Ignore Prowlarr results with fewer seeders than this
PROWLARR_MIN_SEEDERS=0

# Max Prowlarr results stored/returned per search
PROWLARR_MAX_RESULTS=12

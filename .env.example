# ==========================================
# HYDRA TORRENTS - ENVIRONMENT CONFIGURATION
# ==========================================

# Connection string for Layerbase PostgreSQL database
# Format: postgres://username:password@layerbase-host:5432/dbname?sslmode=require
LAYERBASE_DATABASE_URL=postgres://user:password@db.layerbase.com:5432/hydra_db?sslmode=require

# Secret Token for Admin Panel access and protected API operations
ADMIN_SECRET=hydra_super_secret_token_change_me_123

# Server Port (used in standalone Express mode, default: 7000)
PORT=7000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Solo para pruebas: inserta datos demo (magnets de ejemplo) si la tabla está vacía. Déjalo en false en producción.
SEED_DEMO_DATA=false

# ==========================================
# 🌐 BUSCADOR DE WEBS TORRENT (scrapers)
# ==========================================
# Los scrapers buscan cada solicitud en: DonTorrent, MejorTorrent, Pelispanda,
# EliteTorrent, SinSitio y LimeTorrent. SOLO se acepta contenido de habla hispana
# (latino, castellano, español o subtitulado al español).

# Sitios activos (separados por coma). Quita los que no quieras usar.
SCRAPER_SITES=dontorrent,mejortorrent,pelispanda,elitetorrent,sinsitio,limetorrent

# Aceptar también VOSE (versión original subtitulada al español). true/false
SCRAPER_ALLOW_VOSE=true

# Buscar en las webs al resolver streams de Stremio (refuerzo de la bóveda).
SCRAPER_STREAMS_ENABLED=true

# Máximo de streams web añadidos por petición de Stremio.
SCRAPER_MAX_STREAMS=8

# Máximo de resultados por sitio en el buscador.
SCRAPER_MAX_PER_SITE=10

# Timeout (ms) y caché (segundos) de las peticiones a las webs.
SCRAPER_TIMEOUT_MS=9000
SCRAPER_CACHE_TTL_SECONDS=600

# Los dominios de estas webs rotan a menudo: sobrescríbelos aquí si cambian.
SCRAPER_DONTORRENT_URL=https://dontorrent.meme
SCRAPER_MEJORTORRENT_URL=https://www47.mejortorrent.eu
SCRAPER_PELISPANDA_URL=https://pelispanda.org
SCRAPER_ELITETORRENT_URL=https://www.elitetorrent.com
SCRAPER_SINSITIO_URL=https://www.sinsitio.site
SCRAPER_LIMETORRENT_URL=https://limetorrent.net

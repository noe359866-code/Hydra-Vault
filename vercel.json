{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/configure", "destination": "/public/index.html" },
    { "source": "/admin", "destination": "/public/admin.html" },
    { "source": "/styles.css", "destination": "/public/styles.css" },
    { "source": "/admin.js", "destination": "/public/admin.js" },
    { "source": "/favicon.svg", "destination": "/public/favicon.svg" },
    { "source": "/api/admin/add", "destination": "/api/admin/add.js" },
    { "source": "/api/admin/list", "destination": "/api/admin/list.js" },
    { "source": "/api/admin/delete", "destination": "/api/admin/delete.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
